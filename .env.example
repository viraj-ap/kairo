# All optional.

# Sync server origin (ws:// or wss://). Default: the page's own origin, which is right
# when the Worker serves the app (production) or Vite proxies /sync (npm run dev).
# VITE_SYNC_URL=wss://kairo.example.com

# Your own STUN/TURN servers for peer-to-peer media (JSON RTCIceServer[]), e.g. coturn.
# These are added to the ones the Worker serves at /ice (Cloudflare STUN, or Cloudflare TURN when
# the TURN_KEY_ID / TURN_KEY_API_TOKEN Worker secrets are set; see README → Deploy).
# VITE_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"kairo","credential":"secret"}]
